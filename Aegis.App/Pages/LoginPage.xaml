<Page x:Class="Aegis.App.Pages.LoginPage"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   Background="#1B1B1B">

    <Grid>

        <!-- ========================================================= -->
        <!-- MAIN CARD -->
        <!-- ========================================================= -->

        <Border
        Padding="28"
        CornerRadius="10"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        Background="#252525"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        MaxWidth="900"
        MinWidth="700">

            <Border.Effect>
                <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="3"
                Opacity="0.35"/>
            </Border.Effect>


            <Grid>

                <Grid.RowDefinitions>

                    <!-- Main content -->
                    <RowDefinition Height="Auto"/>

                    <!-- Footer -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- MAIN CONTENT -->
                <!-- ================================================= -->

                <Grid
                Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <!-- Login -->
                        <ColumnDefinition
                        Width="3*"
                        MinWidth="300"/>

                        <!-- Divider -->
                        <ColumnDefinition
                        Width="1"/>

                        <!-- Security -->
                        <ColumnDefinition
                        Width="2*"
                        MinWidth="240"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- LOGIN PANEL -->
                    <!-- ================================================= -->

                    <StackPanel
                    Grid.Column="0"
                    Margin="0,0,28,0">


                        <!-- Application Name -->

                        <TextBlock
                        Text="AEGIS"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="White"
                        HorizontalAlignment="Center"/>


                        <TextBlock
                        Text="Secure Vault"
                        FontSize="12"
                        Foreground="#969696"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,24"/>


                        <!-- Username -->

                        <TextBlock
                        Text="Username"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"
                        Margin="0,0,0,6"/>


                        <TextBox
                        x:Name="UsernameBox"
                        Height="38"
                        Padding="10,6"
                        Background="#323232"
                        Foreground="White"
                        BorderBrush="#4C4C4C"
                        BorderThickness="1"
                        FontSize="14"/>


                        <!-- Password -->

                        <TextBlock
                        Text="Password"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"
                        Margin="0,16,0,6"/>


                        <PasswordBox
                        x:Name="PasswordBox"
                        Height="38"
                        Padding="10,6"
                        Background="#323232"
                        Foreground="White"
                        BorderBrush="#4C4C4C"
                        BorderThickness="1"
                        FontSize="14"/>


                        <!-- Forgot Password -->

                        <Button
                        x:Name="ForgotPasswordButton"
                        Content="Forgot Password?"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#5EA9FF"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Padding="0"
                        Margin="0,6,0,0"
                        Click="ForgotPasswordButton_Click">

                            <Button.Template>

                                <ControlTemplate
                                TargetType="Button">

                                    <TextBlock
                                    Text="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    TextDecorations="Underline"/>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>


                        <!-- Remember Me -->

                        <CheckBox
                        x:Name="RememberMeCheckBox"
                        Content="Remember Me"
                        Foreground="#E5E5E5"
                        FontSize="12"
                        Margin="0,14,0,20"/>


                        <!-- Login -->

                        <Button
                        x:Name="LoginButton"
                        Content="Login"
                        Height="42"
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource AegisButton}"
                        Click="LoginButton_Click"/>


                        <!-- Logout -->

                        <Button
                        x:Name="LogoutButton"
                        Content="Logout"
                        Height="42"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource AegisButton}"
                        Click="LogoutButton_Click"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- VERTICAL DIVIDER -->
                    <!-- ================================================= -->

                    <Border
                    Grid.Column="1"
                    Width="1"
                    Background="#3A3A3A"
                    Margin="0,10,0,10"/>


                    <!-- ================================================= -->
                    <!-- SECURITY PANEL -->
                    <!-- ================================================= -->

                    <StackPanel
                    Grid.Column="2"
                    Margin="28,10,0,0">


                        <!-- Header -->

                        <TextBlock
                        Text="SECURITY STATUS"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,0,4"/>


                        <TextBlock
                        Text="Current session and system security"
                        FontSize="11"
                        Foreground="#777777"
                        Margin="0,0,0,18"
                        TextWrapping="Wrap"/>


                        <!-- ================================================= -->
                        <!-- SESSION -->
                        <!-- ================================================= -->

                        <TextBlock
                        Text="SESSION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#707070"
                        Margin="0,0,0,8"/>


                        <!-- Session ID -->

                        <Grid
                        Margin="0,0,0,7">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Session ID"
                            FontSize="11"
                            Foreground="#999999"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="SessionIdText"
                            Grid.Column="1"
                            Text="N/A"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#D5D5D5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- Valid Session -->

                        <Grid
                        Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Valid Session"
                            FontSize="11"
                            Foreground="#999999"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="SessionStatusText"
                            Grid.Column="1"
                            Text="—"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- WINDOWS SECURITY POSTURE -->
                        <!-- ================================================= -->

                        <TextBlock
                        Text="WINDOWS SECURITY"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#707070"
                        Margin="0,0,0,12"/>


                        <!-- ================================================= -->
                        <!-- SECURE BOOT -->
                        <!-- ================================================= -->

                        <Grid
                        Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Secure Boot"
                            FontSize="11"
                            Foreground="#999999"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="SecureBootStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- TPM 2.0 -->
                        <!-- ================================================= -->

                        <Grid
                        Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="TPM 2.0"
                            FontSize="11"
                            Foreground="#999999"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="TpmStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- VBS -->
                        <!-- ================================================= -->

                        <Grid
                        Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Virtualization-Based Security"
                            FontSize="11"
                            Foreground="#999999"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="VbsStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- HVCI -->
                        <!-- ================================================= -->

                        <Grid
                        Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Memory Integrity (HVCI)"
                            FontSize="11"
                            Foreground="#999999"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="HvciStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- KERNEL DMA -->
                        <!-- ================================================= -->

                        <Grid
                        Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Kernel DMA Protection"
                            FontSize="11"
                            Foreground="#999999"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="DmaStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- CREDENTIAL GUARD -->
                        <!-- ================================================= -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                Width="*"/>

                                <ColumnDefinition
                                Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Text="Credential Guard"
                            FontSize="11"
                            Foreground="#999999"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            x:Name="CredentialGuardStatus"
                            Grid.Column="1"
                            Text="—"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#777777"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"/>

                        </Grid>

                    </StackPanel>

                </Grid>

                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <Grid
                Grid.Row="1"
                Margin="0,22,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                        Width="*"/>

                        <ColumnDefinition
                        Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock
                    Text="Aegis Encryption Suite"
                    FontSize="10"
                    Foreground="#707070"
                    VerticalAlignment="Center"/>

                    <Border
                    Grid.Column="1"
                    Padding="8,3"
                    CornerRadius="8"
                    Background="#1E5F28">

                        <TextBlock
                        Text="SECURE"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="White"/>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>













