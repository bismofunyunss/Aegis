<Page
    x:Class="Aegis.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="SettingsPage"
    Width="750"
    Background="{x:Null}">

    <Page.Resources>

        <!-- ========================================================= -->
        <!-- INTEGER INPUT STYLE                                      -->
        <!-- ========================================================= -->

        <Style
            x:Key="DarkIntegerUpDownStyle"
            TargetType="{x:Type xctk:IntegerUpDown}">

            <Setter
                Property="Background"
                Value="#2A2A2A"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="BorderBrush"
                Value="#555555"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="Padding"
                Value="6,2"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Right"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>

        </Style>

    </Page.Resources>


    <!-- ============================================================= -->
    <!-- PAGE                                                          -->
    <!-- ============================================================= -->

    <Grid>

        <Border
            Width="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1E1E1E"
            BorderBrush="#444444"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22">

            <Border.Effect>

                <DropShadowEffect
                    Color="#000000"
                    BlurRadius="18"
                    ShadowDepth="4"
                    Opacity="0.40"/>

            </Border.Effect>


            <Grid>

                <Grid.RowDefinitions>

                    <!-- Header -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- FIPS -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Main settings -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- KDF optimizer -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Notice -->
                    <RowDefinition
                        Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,18">

                    <TextBlock
                        Text="Security Settings"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Configure authentication, password derivation, and cryptographic security."
                        Foreground="#888888"
                        FontSize="11"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Margin="0,4,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- FIPS MODE                                         -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="12"
                    Background="#242424"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="6">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="*"/>

                            <ColumnDefinition
                                Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="0">

                            <TextBlock
                                Text="FIPS Mode"
                                Foreground="#E0E0E0"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Use FIPS-approved cryptographic algorithms where supported."
                                Foreground="#888888"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <CheckBox
                            x:Name="UseFipsModeCheckBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,4,0"
                            Checked="UseFipsModeCheckBox_Changed"
                            Unchecked="UseFipsModeCheckBox_Changed"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- MAIN SETTINGS                                      -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="2"
                    Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*"/>

                        <ColumnDefinition
                            Width="12"/>

                        <ColumnDefinition
                            Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ============================================= -->
                    <!-- KEY DERIVATION                                -->
                    <!-- ============================================= -->

                    <Border
                        Grid.Column="0"
                        Padding="14"
                        Background="#242424"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="6">

                        <StackPanel>

                            <TextBlock
                                Text="Key Derivation"
                                Foreground="#E0E0E0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,0,14"/>


                            <!-- PBKDF2 -->

                            <Grid
                                Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="130"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="PBKDF2-SHA256"
                                        Foreground="#CCCCCC"
                                        FontSize="12"/>

                                    <TextBlock
                                        Text="Iterations"
                                        Foreground="#777777"
                                        FontSize="10"
                                        Margin="0,2,0,0"/>

                                </StackPanel>


                                <xctk:IntegerUpDown
                                    x:Name="Pbkdf2IterationsUpDown"
                                    Grid.Column="1"
                                    Height="32"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Value="100000"
                                    Minimum="1"
                                    Maximum="2147483647"
                                    Increment="50000"
                                    ValueChanged="Pbkdf2IterationsUpDown_ValueChanged"/>

                            </Grid>


                            <Border
                                Height="1"
                                Background="#353535"
                                Margin="0,2,0,12"/>


                            <!-- Argon2id -->

                            <TextBlock
                                Text="Argon2id"
                                Foreground="#CCCCCC"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,0,0,10"/>


                            <!-- Argon2 iterations -->

                            <Grid
                                Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Iterations"
                                    Foreground="#999999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>


                                <xctk:IntegerUpDown
                                    x:Name="Argon2IterationsUpDown"
                                    Grid.Column="1"
                                    Height="30"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Value="1"
                                    Minimum="1"
                                    Maximum="64"
                                    Increment="1"
                                    ValueChanged="Argon2IterationsUpDown_ValueChanged"/>

                            </Grid>


                            <!-- Argon2 memory -->

                            <Grid
                                Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Memory (MiB)"
                                    Foreground="#999999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>


                                <xctk:IntegerUpDown
                                    x:Name="Argon2MemoryUpDown"
                                    Grid.Column="1"
                                    Height="30"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Value="2048"
                                    Minimum="1024"
                                    Maximum="32768"
                                    Increment="1024"
                                    ValueChanged="Argon2MemoryUpDown_ValueChanged"/>

                            </Grid>


                            <!-- Argon2 parallelism -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Parallelism"
                                    Foreground="#999999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>


                                <xctk:IntegerUpDown
                                    x:Name="Argon2ParallelismUpDown"
                                    Grid.Column="1"
                                    Height="30"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Value="4"
                                    Minimum="1"
                                    Maximum="32"
                                    Increment="1"
                                    ValueChanged="Argon2ParallelismUpDown_ValueChanged"/>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ============================================= -->
                    <!-- PASSWORD                                       -->
                    <!-- ============================================= -->

                    <Border
                        Grid.Column="2"
                        Padding="14"
                        Background="#242424"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition
                                    Height="Auto"/>

                                <RowDefinition
                                    Height="Auto"/>

                                <RowDefinition
                                    Height="Auto"/>

                                <RowDefinition
                                    Height="Auto"/>

                            </Grid.RowDefinitions>


                            <TextBlock
                                Grid.Row="0"
                                Text="Password"
                                Foreground="#E0E0E0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>


                            <TextBlock
                                Grid.Row="1"
                                Text="Change your account password."
                                Foreground="#CCCCCC"
                                FontSize="12"/>


                            <TextBlock
                                Grid.Row="2"
                                Text="The existing account key hierarchy will be reprotected using the new password."
                                Foreground="#777777"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Margin="0,4,0,18"/>


                            <Button
                                Grid.Row="3"
                                Content="Change Password"
                                Width="170"
                                Height="36"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Style="{StaticResource AegisButton}"
                                Click="ChangePasswordButton_Click"/>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- KDF OPTIMIZATION                                  -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="3"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="#242424"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="6">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                            <RowDefinition
                                Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- Header -->

                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                    Width="*"/>

                                <ColumnDefinition
                                    Width="180"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,20,0">

                                <TextBlock
                                    Text="KDF Optimization"
                                    Foreground="#E0E0E0"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Benchmark PBKDF2-SHA256 and Argon2id using a derivation time you are comfortable with."
                                    Foreground="#888888"
                                    FontSize="10"
                                    TextWrapping="Wrap"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <!-- Target time -->

                            <Grid
                                Grid.Column="1">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="90"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">

                                    <TextBlock
                                        Text="Target Time"
                                        Foreground="#CCCCCC"
                                        FontSize="11"/>

                                    <TextBlock
                                        Text="Milliseconds"
                                        Foreground="#777777"
                                        FontSize="9"/>

                                </StackPanel>


                                <xctk:IntegerUpDown
                                    x:Name="KdfTargetMillisecondsUpDown"
                                    Grid.Column="1"
                                    Height="32"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Value="10000"
                                    Minimum="100"
                                    Maximum="720000"
                                    Increment="10000"
                                    ValueChanged="KdfTargetMillisecondsUpDown_ValueChanged"
                                    ToolTip="Target derivation time used by both KDF optimizers. Every 10,000ms is 10 seconds."/>

                            </Grid>

                        </Grid>


                        <!-- Optimizer cards -->

                        <Grid
                            Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                    Width="*"/>

                                <ColumnDefinition
                                    Width="12"/>

                                <ColumnDefinition
                                    Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- PBKDF2 optimizer -->

                            <Border
                                Grid.Column="0"
                                Padding="10"
                                Background="#202020"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition
                                            Width="*"/>

                                        <ColumnDefinition
                                            Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">

                                        <TextBlock
                                            Text="PBKDF2-SHA256"
                                            Foreground="#D8D8D8"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            x:Name="Pbkdf2OptimizationStatusText"
                                            Text="No optimization performed."
                                            Foreground="#666666"
                                            FontSize="9"
                                            TextWrapping="Wrap"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <Button
                                        x:Name="OptimizePbkdf2Button"
                                        Grid.Column="1"
                                        Width="100"
                                        Height="32"
                                        Content="Optimize"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource AegisButton}"
                                        Click="OptimizePbkdf2Button_Click"/>

                                </Grid>

                            </Border>


                            <!-- Argon2 optimizer -->

                            <Border
                                Grid.Column="2"
                                Padding="10"
                                Background="#202020"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition
                                            Width="*"/>

                                        <ColumnDefinition
                                            Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">

                                        <TextBlock
                                            Text="Argon2id"
                                            Foreground="#D8D8D8"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            x:Name="Argon2OptimizationStatusText"
                                            Text="No optimization performed."
                                            Foreground="#666666"
                                            FontSize="9"
                                            TextWrapping="Wrap"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <Button
                                        x:Name="OptimizeArgon2Button"
                                        Grid.Column="1"
                                        Width="100"
                                        Height="32"
                                        Content="Optimize"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource AegisButton}"
                                        Click="OptimizeArgon2Button_Click"/>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- Optimize both -->

                        <Grid
                            Grid.Row="2"
                            Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition
                                    Width="*"/>

                                <ColumnDefinition
                                    Width="Auto"/>

                                <ColumnDefinition
                                    Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Run both optimizers using the selected target time."
                                Foreground="#666666"
                                FontSize="9"
                                TextWrapping="Wrap"/>


                            <Button
                                x:Name="OptimizeAllKdfButton"
                                Grid.Column="1"
                                Width="170"
                                Height="34"
                                Content="Optimize Both"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Style="{StaticResource AegisButton}"
                                Click="OptimizeAllKdfButton_Click"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- SECURITY NOTICE                                   -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="4"
                    Padding="10"
                    Background="#202020"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="6">

                    <TextBlock
                        Text="KDF optimization is hardware-dependent. Higher derivation times increase resistance to password guessing but also increase login and password-change time. Changes to cryptographic parameters may affect compatibility with existing vault data."
                        Foreground="#777777"
                        FontSize="10"
                        TextWrapping="Wrap"
                        TextAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>




