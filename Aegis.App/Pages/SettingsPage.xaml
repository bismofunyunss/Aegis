<Page
    x:Class="Aegis.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="SettingsPage"
    Width="750"
    Background="{x:Null}">

    <!-- ========================= -->
    <!-- Page Resources            -->
    <!-- ========================= -->

    <Page.Resources>

        <Style
            x:Key="DarkIntegerUpDownStyle"
            TargetType="{x:Type xctk:IntegerUpDown}">

            <Setter
                Property="Background"
                Value="#2A2A2A"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="BorderBrush"
                Value="#555"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="Padding"
                Value="6,2"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Right"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>

        </Style>

    </Page.Resources>


    <!-- ========================= -->
    <!-- Layout                    -->
    <!-- ========================= -->

    <Grid>

        <Border
            Width="760"
            MaxHeight="760"
            CornerRadius="12"
            BorderBrush="#444"
            BorderThickness="1"
            Background="#1E1E1E"
            Padding="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect
                    Color="#000000"
                    BlurRadius="18"
                    ShadowDepth="4"
                    Opacity="0.40"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition
                        Height="Auto"/>

                    <RowDefinition
                        Height="Auto"/>

                    <RowDefinition
                        Height="Auto"/>

                    <RowDefinition
                        Height="Auto"/>

                    <RowDefinition
                        Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ========================= -->
                <!-- HEADER                    -->
                <!-- ========================= -->

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,18">

                    <TextBlock
                        Text="Security Settings"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Configure authentication and key-derivation security."
                        Foreground="#888"
                        FontSize="11"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"/>

                </StackPanel>


                <!-- ========================= -->
                <!-- FIPS                      -->
                <!-- ========================= -->

                <Border
                    Grid.Row="1"
                    CornerRadius="6"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    Background="#242424"
                    Padding="12"
                    Margin="0,0,0,12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="*"/>

                            <ColumnDefinition
                                Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="FIPS Mode"
                                Foreground="#E0E0E0"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Use FIPS-approved cryptographic algorithms."
                                Foreground="#888"
                                FontSize="11"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                        <CheckBox
                            x:Name="UseFipsModeCheckBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,4,0"
                            Checked="UseFipsModeCheckBox_Changed"
                            Unchecked="UseFipsModeCheckBox_Changed"/>

                    </Grid>

                </Border>


                <!-- ========================= -->
                <!-- MAIN SETTINGS              -->
                <!-- ========================= -->

                <Grid
                    Grid.Row="2"
                    Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*"/>

                        <ColumnDefinition
                            Width="12"/>

                        <ColumnDefinition
                            Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ===================== -->
                    <!-- KEY DERIVATION         -->
                    <!-- ===================== -->

                    <Border
                        Grid.Column="0"
                        CornerRadius="6"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        Background="#242424"
                        Padding="14">

                        <StackPanel>

                            <TextBlock
                                Text="Key Derivation"
                                Foreground="#E0E0E0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>


                            <!-- PBKDF2 -->

                            <Grid
                                Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="130"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="PBKDF2"
                                        Foreground="#CCC"
                                        FontSize="12"/>

                                    <TextBlock
                                        Text="Iterations"
                                        Foreground="#777"
                                        FontSize="10"/>

                                </StackPanel>

                                <xctk:IntegerUpDown
                                    x:Name="Pbkdf2IterationsUpDown"
                                    Grid.Column="1"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Height="32"
                                    Value="100000"
                                    Minimum="1"
                                    Increment="50000"
                                    ValueChanged="Pbkdf2IterationsUpDown_ValueChanged"/>

                            </Grid>


                            <Border
                                Height="1"
                                Background="#353535"
                                Margin="0,0,0,12"/>


                            <!-- Argon2 Header -->

                            <TextBlock
                                Text="Argon2id"
                                Foreground="#CCC"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,0,0,10"/>


                            <!-- Argon2 Iterations -->

                            <Grid
                                Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Iterations"
                                    Foreground="#999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>

                                <xctk:IntegerUpDown
                                    x:Name="Argon2IterationsUpDown"
                                    Grid.Column="1"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Height="30"
                                    Value="1"
                                    Minimum="1"
                                    ValueChanged="Argon2IterationsUpDown_ValueChanged"/>

                            </Grid>


                            <!-- Argon2 Memory -->

                            <Grid
                                Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Memory (MB)"
                                    Foreground="#999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>

                                <xctk:IntegerUpDown
                                    x:Name="Argon2MemoryUpDown"
                                    Grid.Column="1"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Height="30"
                                    Value="256"
                                    Minimum="1024"
                                    Maximum="33554432"
                                    Increment="1024"
                                    ValueChanged="Argon2MemoryUpDown_ValueChanged"/>

                            </Grid>


                            <!-- Argon2 Parallelism -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*"/>

                                    <ColumnDefinition
                                        Width="110"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Parallelism"
                                    Foreground="#999"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>

                                <xctk:IntegerUpDown
                                    x:Name="Argon2ParallelismUpDown"
                                    Grid.Column="1"
                                    Style="{StaticResource DarkIntegerUpDownStyle}"
                                    Height="30"
                                    Value="1"
                                    Minimum="1"
                                    ValueChanged="Argon2ParallelismUpDown_ValueChanged"/>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ===================== -->
                    <!-- PASSWORD OPTIONS       -->
                    <!-- ===================== -->

                    <Border
                        Grid.Column="2"
                        CornerRadius="6"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        Background="#242424"
                        Padding="14">

                        <StackPanel>

                            <TextBlock
                                Text="Password"
                                Foreground="#E0E0E0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>

                            <TextBlock
                                Text="Change your account password."
                                Foreground="#CCC"
                                FontSize="12"/>

                            <TextBlock
                                Text="The master key will be rewrapped using the new password."
                                Foreground="#777"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Margin="0,4,0,18"/>

                            <Button
                                Content="Change Password"
                                Width="170"
                                Height="36"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Style="{StaticResource AegisButton}"
                                Click="ChangePasswordButton_Click">

                            </Button>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ========================= -->
                <!-- ARGON2 OPTIMIZER           -->
                <!-- ========================= -->

                <Border
                    Grid.Row="3"
                    CornerRadius="6"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    Background="#242424"
                    Padding="14"
                    Margin="0,0,0,12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="*"/>

                            <ColumnDefinition
                                Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                            <TextBlock
                                Text="Optimize Argon2id"
                                Foreground="#E0E0E0"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Automatically benchmark your system and select a stronger memory, iteration, and parallelism configuration."
                                Foreground="#888"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Margin="0,4,0,0"/>

                            <TextBlock
                                x:Name="Argon2OptimizationStatusText"
                                Text="No optimization performed."
                                Foreground="#666666"
                                FontSize="10"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                        <Button
                            x:Name="OptimizeArgon2Button"
                            Grid.Column="1"
                            Width="150"
                            Height="38"
                            Content="Optimize Argon2id"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Style="{StaticResource AegisButton}"
                            Click="OptimizeArgon2Button_Click">

                        </Button>

                    </Grid>

                </Border>


                <!-- ========================= -->
                <!-- SECURITY NOTICE            -->
                <!-- ========================= -->

                <Border
                    Grid.Row="4"
                    CornerRadius="6"
                    Background="#202020"
                    BorderBrush="#333"
                    BorderThickness="1"
                    Padding="10">

                    <TextBlock
                        Text="Changes to cryptographic parameters may affect compatibility with existing vault data."
                        Foreground="#777"
                        FontSize="10"
                        TextWrapping="Wrap"
                        TextAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>




