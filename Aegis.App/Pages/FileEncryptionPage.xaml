<Page
    x:Class="Aegis.App.Pages.FileEncryptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#121212">

    <Grid>

        <!-- ========================================================= -->
        <!-- MAIN CONTAINER -->
        <!-- ========================================================= -->

        <Border
            Width="680"
            MaxWidth="680"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1B1B1B"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="12">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    ShadowDepth="4"
                    Opacity="0.30"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>

                    <!-- File selection -->
                    <RowDefinition Height="Auto"/>

                    <!-- Actions -->
                    <RowDefinition Height="Auto"/>

                    <!-- Status -->
                    <RowDefinition Height="Auto"/>

                    <!-- Progress -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="AEGIS ENCRYPTION"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            Text="Secure file encryption and decryption"
                            FontSize="11"
                            Foreground="#777777"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="9,5"
                        VerticalAlignment="Center"
                        Background="#193D25"
                        BorderBrush="#285B37"
                        BorderThickness="1"
                        CornerRadius="6">

                        <TextBlock
                            Text="SECURE"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="#8FDEA4"/>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- FILE SELECTION -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="1"
                    Height="110"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="#202020"
                    BorderBrush="#343434"
                    BorderThickness="1"
                    CornerRadius="8"
                    AllowDrop="True"
                    DragOver="FileDropZone_DragOver"
                    Drop="FileDropZone_Drop">

                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="FILE SELECTION"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="#707070"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Drop a file here"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#E5E5E5"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"/>

                        <TextBlock
                            Text="or select a file using Open File"
                            FontSize="10"
                            Foreground="#707070"
                            HorizontalAlignment="Center"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- ACTIONS -->
                <!-- ================================================= -->

                <Border
    Grid.Row="2"
    Margin="0,0,0,16"
    Padding="10"
    Background="#202020"
    BorderBrush="#303030"
    BorderThickness="1"
    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Open -->

                        <Button
            x:Name="OpenFileButton"
            Grid.Row="0"
            Grid.Column="0"
            Height="40"
            Margin="4"
            Content="Open File"
            Style="{StaticResource AegisButton}"
            Click="OpenFileButton_Click"/>


                        <!-- Save -->

                        <Button
            x:Name="SaveFileButton"
            Grid.Row="0"
            Grid.Column="1"
            Height="40"
            Margin="4"
            Content="Save As"
            Style="{StaticResource AegisButton}"
            Click="SaveFileButton_Click"/>


                        <!-- Encrypt -->

                        <Button
            x:Name="EncryptFileButton"
            Grid.Row="1"
            Grid.Column="0"
            Height="40"
            Margin="4"
            Content="Encrypt"
            Style="{StaticResource AegisButton}"
            Click="EncryptFileButton_Click"/>


                        <!-- Decrypt -->

                        <Button
            x:Name="DecryptFileButton"
            Grid.Row="1"
            Grid.Column="1"
            Height="40"
            Margin="4"
            Content="Decrypt"
            Style="{StaticResource AegisButton}"
            Click="DecryptFileButton_Click"/>


                        <!-- Cancel -->

                        <Button
            x:Name="CancelOperationButton"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="36"
            Margin="4,10,4,4"
            Content="Cancel Operation"
            IsEnabled="False"
            Style="{StaticResource AegisButton}"
            Click="CancelOperationButton_Click"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,16"
                    Padding="12"
                    Background="#202020"
                    BorderBrush="#303030"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <!-- Status -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="DeepSkyBlue"/>

                            <TextBlock
                                x:Name="StatusLbl"
                                Grid.Column="1"
                                Text="Idle"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#D8D8D8"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- File -->

                        <Grid
                            Margin="16,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="FILE:"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#666666"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="FileStatusLbl"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Text="No file selected"
                                FontSize="10"
                                Foreground="#888888"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- PROGRESS / CANCELLATION -->
                <!-- ================================================= -->

                <Border
                    x:Name="ProgressPanel"
                    Grid.Row="4"
                    Padding="12"
                    Background="#202020"
                    BorderBrush="#303030"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Visible">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Progress header -->

                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,8">

                            <TextBlock
                                Text="CURRENT PROGRESS"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#707070"/>

                            <TextBlock
                                x:Name="ProgressPercentageText"
                                HorizontalAlignment="Right"
                                Text="0%"
                                FontSize="10"
                                Foreground="#A0A0A0"/>

                        </Grid>


                        <!-- Progress bar -->

                        <ProgressBar
                            x:Name="ProgressBar"
                            Grid.Row="1"
                            Height="6"
                            Minimum="0"
                            Maximum="100"
                            Foreground="#3B82F6"
                            Background="#303030"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>





































