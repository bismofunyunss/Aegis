<Window
    x:Class="Aegis.App.Pages.ChangePassword"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Aegis.App.Pages"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="700"
    Title="Change Password"
    Width="620"
    Height="700"
    MinWidth="620"
    MinHeight="700"
    MaxWidth="620"
    MaxHeight="700"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="#121212">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- PASSWORD BOX                                               -->
        <!-- ========================================================= -->

        <Style
            x:Key="AegisPasswordBox"
            TargetType="PasswordBox">

            <Setter
                Property="Height"
                Value="40"/>

            <Setter
                Property="Padding"
                Value="10,6"/>

            <Setter
                Property="FontSize"
                Value="13"/>

            <Setter
                Property="Foreground"
                Value="White"/>

            <Setter
                Property="Background"
                Value="#292929"/>

            <Setter
                Property="BorderBrush"
                Value="#444444"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>

        </Style>


        <!-- ========================================================= -->
        <!-- SECONDARY BUTTON                                           -->
        <!-- ========================================================= -->

        <Style
            x:Key="SecondaryButton"
            TargetType="Button">

            <Setter
                Property="Height"
                Value="40"/>

            <Setter
                Property="Padding"
                Value="18,0"/>

            <Setter
                Property="FontSize"
                Value="12"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Foreground"
                Value="#D8D8D8"/>

            <Setter
                Property="Background"
                Value="#292929"/>

            <Setter
                Property="BorderBrush"
                Value="#444444"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="Cursor"
                Value="Hand"/>

            <Setter
                Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#343434"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#505050"/>

                            </Trigger>


                            <!-- Pressed -->

                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#202020"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#444444"/>

                            </Trigger>


                            <!-- Disabled -->

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#242424"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#303030"/>

                                <Setter
                                    Property="Foreground"
                                    Value="#666666"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- MAIN WINDOW                                                    -->
    <!-- ============================================================= -->

    <Grid>

        <!-- ========================================================= -->
        <!-- MAIN CARD                                                   -->
        <!-- ========================================================= -->

        <Border
            Width="560"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1B1B1B"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="12">

            <Border.Effect>

                <DropShadowEffect
                    BlurRadius="22"
                    ShadowDepth="4"
                    Opacity="0.35"/>

            </Border.Effect>


            <Grid>

                <Grid.RowDefinitions>

                    <!-- Header -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Security notice -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Form -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Password strength -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Status -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Actions -->
                    <RowDefinition
                        Height="Auto"/>

                    <!-- Footer -->
                    <RowDefinition
                        Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,20">

                    <TextBlock
                        Text="CHANGE PASSWORD"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Update the password used to protect your Aegis account."
                        FontSize="11"
                        Foreground="#777777"
                        Margin="0,4,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SECURITY NOTICE                                   -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    Padding="12"
                    Background="#202020"
                    BorderBrush="#343434"
                    BorderThickness="1"
                    CornerRadius="7">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="Auto"/>

                            <ColumnDefinition
                                Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,9,0"
                            VerticalAlignment="Top"
                            Fill="DeepSkyBlue"/>


                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="Security-sensitive operation"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D8D8D8"/>

                            <TextBlock
                                Text="Your current password is required. The new password will be used to protect your Aegis account and associated cryptographic key material."
                                FontSize="10"
                                Foreground="#777777"
                                TextWrapping="Wrap"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- PASSWORD FORM                                     -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="2">

                    <Grid.RowDefinitions>

                        <!-- Current label -->
                        <RowDefinition
                            Height="Auto"/>

                        <!-- Current password -->
                        <RowDefinition
                            Height="Auto"/>

                        <!-- New label -->
                        <RowDefinition
                            Height="Auto"/>

                        <!-- New password -->
                        <RowDefinition
                            Height="Auto"/>

                        <!-- Confirm label -->
                        <RowDefinition
                            Height="Auto"/>

                        <!-- Confirm password -->
                        <RowDefinition
                            Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Current password -->

                    <TextBlock
                        Grid.Row="0"
                        Text="Current Password"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D8D8D8"
                        Margin="0,0,0,6"/>


                    <PasswordBox
                        x:Name="CurrentPasswordBox"
                        Grid.Row="1"
                        Style="{StaticResource AegisPasswordBox}"
                        Margin="0,0,0,16"/>


                    <!-- New password -->

                    <TextBlock
                        Grid.Row="2"
                        Text="New Password"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D8D8D8"
                        Margin="0,0,0,6"/>


                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Grid.Row="3"
                        Style="{StaticResource AegisPasswordBox}"
                        PasswordChanged="NewPasswordBox_PasswordChanged"
                        Margin="0,0,0,8"/>


                    <!-- Confirm password -->

                    <TextBlock
                        Grid.Row="4"
                        Text="Confirm New Password"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D8D8D8"
                        Margin="0,0,0,6"/>


                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Grid.Row="5"
                        Style="{StaticResource AegisPasswordBox}"
                        PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                </Grid>


                <!-- ================================================= -->
                <!-- PASSWORD STRENGTH                                  -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="10"
                    Background="#202020"
                    BorderBrush="#303030"
                    BorderThickness="1"
                    CornerRadius="7">

                    <StackPanel>

                        <Grid
                            Margin="0,0,0,7">

                            <TextBlock
                                Text="PASSWORD STRENGTH"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#707070"/>

                            <TextBlock
                                x:Name="PasswordEntropyText"
                                HorizontalAlignment="Right"
                                Text="Entropy: 0 bits"
                                FontSize="9"
                                Foreground="#777777"/>

                        </Grid>


                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="7"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            Background="#303030"
                            Foreground="#4B9BFF"/>


                        <TextBlock
                            x:Name="PasswordRequirementsText"
                            Text="Use a long, unique password containing a mix of character types."
                            FontSize="9"
                            Foreground="#666666"
                            TextWrapping="Wrap"
                            Margin="0,7,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- STATUS                                            -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Padding="10"
                    Background="#202020"
                    BorderBrush="#303030"
                    BorderThickness="1"
                    CornerRadius="7">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="Auto"/>

                            <ColumnDefinition
                                Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="#555555"/>


                        <TextBlock
                            x:Name="StatusText"
                            Grid.Column="1"
                            Text="Ready"
                            FontSize="10"
                            Foreground="#999999"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ACTIONS                                            -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="5"
                    Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*"/>

                        <ColumnDefinition
                            Width="Auto"/>

                        <ColumnDefinition
                            Width="10"/>

                        <ColumnDefinition
                            Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <Button
                        x:Name="CancelButton"
                        Grid.Column="1"
                        Width="110"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click"/>


                    <Button
                        x:Name="ChangePasswordButton"
                        Grid.Column="3"
                        Width="160"
                        Content="Change Password"
                        Style="{StaticResource AegisButton}"
                        IsEnabled="False"
                        Click="ChangePasswordButton_Click"/>

                </Grid>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <TextBlock
                    Grid.Row="6"
                    Text="Aegis Encryption Suite"
                    FontSize="9"
                    Foreground="#555555"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>

