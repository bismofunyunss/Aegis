<Page
    x:Class="Aegis.App.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1B1B1B">

    <Grid>

        <!-- ========================================================= -->
        <!-- MAIN CARD -->
        <!-- ========================================================= -->

        <Border
            Width="520"
            MaxWidth="520"
            Padding="32"
            CornerRadius="10"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            Background="#252525"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect
                    BlurRadius="18"
                    ShadowDepth="3"
                    Opacity="0.35"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>

                    <!-- Application name -->
                    <RowDefinition Height="Auto"/>

                    <!-- Subtitle -->
                    <RowDefinition Height="Auto"/>

                    <!-- Registration content -->
                    <RowDefinition Height="Auto"/>

                    <!-- Footer -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- BRANDING -->
                <!-- ================================================= -->

                <!--
                    Keep your existing logo control/image here if the
                    newer XAML had one. The supplied conflict does not
                    contain the stashed logo element.
                -->


                <!-- ================================================= -->
                <!-- APPLICATION NAME -->
                <!-- ================================================= -->

                <TextBlock
                    Grid.Row="1"
                    Text="AEGIS"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"/>


                <!-- ================================================= -->
                <!-- SUBTITLE -->
                <!-- ================================================= -->

                <TextBlock
                    Grid.Row="2"
                    Text="Create Secure Vault Account"
                    FontSize="12"
                    Foreground="#969696"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,28"/>


                <!-- ================================================= -->
                <!-- REGISTRATION FORM -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="3">

                    <Grid.RowDefinitions>

                        <!-- Username label -->
                        <RowDefinition Height="Auto"/>

                        <!-- Username -->
                        <RowDefinition Height="Auto"/>

                        <!-- Password label -->
                        <RowDefinition Height="Auto"/>

                        <!-- Password -->
                        <RowDefinition Height="Auto"/>

                        <!-- Entropy -->
                        <RowDefinition Height="Auto"/>

                        <!-- Strength -->
                        <RowDefinition Height="Auto"/>

                        <!-- Confirm label -->
                        <RowDefinition Height="Auto"/>

                        <!-- Confirm -->
                        <RowDefinition Height="Auto"/>

                        <!-- Register -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- USERNAME -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Row="0"
                        Text="Username"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"
                        Margin="0,0,0,6"/>

                    <TextBox
                        Grid.Row="1"
                        x:Name="UsernameBox"
                        Height="38"
                        Padding="10,6"
                        Background="#323232"
                        Foreground="White"
                        BorderBrush="#4C4C4C"
                        BorderThickness="1"
                        FontSize="14"/>


                    <!-- ================================================= -->
                    <!-- PASSWORD -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Row="2"
                        Text="Password"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"
                        Margin="0,16,0,6"/>

                    <PasswordBox
                        Grid.Row="3"
                        x:Name="PasswordBox"
                        Height="38"
                        Padding="10,6"
                        Background="#323232"
                        Foreground="White"
                        BorderBrush="#4C4C4C"
                        BorderThickness="1"
                        FontSize="14"
                        PasswordChanged="PasswordBox_PasswordChanged"/>


                    <!-- ================================================= -->
                    <!-- PASSWORD ENTROPY -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Row="4"
                        x:Name="PasswordEntropyLabel"
                        Text="Entropy: 0 bits"
                        FontSize="11"
                        Foreground="#999999"
                        Margin="0,7,0,4"/>


                    <!-- ================================================= -->
                    <!-- PASSWORD STRENGTH -->
                    <!-- ================================================= -->

                    <ProgressBar
                        Grid.Row="5"
                        x:Name="PasswordStrengthBar"
                        Height="8"
                        Minimum="0"
                        Maximum="1000"
                        Value="0"
                        Background="#333333"
                        Foreground="#5EA9FF"
                        BorderThickness="0"
                        Margin="0,0,0,14"/>


                    <!-- ================================================= -->
                    <!-- CONFIRM PASSWORD -->
                    <!-- ================================================= -->

                    <TextBlock
                        Grid.Row="6"
                        Text="Confirm Password"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"
                        Margin="0,2,0,6"/>

                    <PasswordBox
                        Grid.Row="7"
                        x:Name="ConfirmPasswordBox"
                        Height="38"
                        Padding="10,6"
                        Background="#323232"
                        Foreground="White"
                        BorderBrush="#4C4C4C"
                        BorderThickness="1"
                        FontSize="14"/>


                    <!-- ================================================= -->
                    <!-- REGISTER -->
                    <!-- ================================================= -->

                    <Button
                        Grid.Row="8"
                        x:Name="RegisterButton"
                        Content="Create Account"
                        Height="42"
                        Margin="0,22,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource AegisButton}"
                        Click="RegisterButton_Click"/>

                </Grid>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <Grid
                    Grid.Row="4"
                    Margin="0,24,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition
                            Width="*"/>

                        <ColumnDefinition
                            Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Text="Aegis Encryption Suite"
                        FontSize="10"
                        Foreground="#707070"
                        VerticalAlignment="Center"/>


                    <Border
                        Grid.Column="1"
                        Padding="8,3"
                        CornerRadius="8"
                        Background="#1E5F28">

                        <TextBlock
                            Text="SECURE"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="White"/>

                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>




















