<Page
 x:Class="Aegis.App.Pages.VaultPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vaultEntry="clr-namespace:Aegis.App.Vault.VaultEntry"
 Background="#1B1B1B">

    <Grid>

        <Border
        Width="900"
        MaxWidth="900"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,30,0,0"
        Padding="16"
        Background="#252525"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        CornerRadius="10">

            <Border.Effect>
                <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="3"
                Opacity="0.30"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TOOLBAR -->
                <!-- ================================================= -->

                <Grid
                Grid.Row="0"
                Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- Section title -->

                    <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

                        <TextBlock
                        Text="VAULT"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                        <TextBlock
                        Text="Secure account credentials"
                        FontSize="10"
                        Foreground="#777777"
                        Margin="0,2,0,0"/>

                    </StackPanel>


                    <!-- Actions -->

                    <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                        <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Add New Entry"
                        Click="AddEntry_Click">

                            <TextBlock
                            Text="+"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#D5D5D5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Button>


                        <Button
                        x:Name="SaveButton"
                        Width="30"
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Save Vault"
                        Click="SaveButton_Click">

                            <TextBlock
                            Text="💾"
                            FontSize="14"
                            Foreground="#D5D5D5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Button>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- VAULT GRID -->
                <!-- ================================================= -->

                <Border
                Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">

                    <DataGrid
                        x:Name="DataGridVault"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ItemsSource="{x:Static vaultEntry:VaultState.Items}"
                        Background="#1E1E1E"
                        Foreground="#E5E5E5"
                        RowBackground="#1E1E1E"
                        AlternatingRowBackground="#242424"
                        GridLinesVisibility="None"
                        BorderThickness="0"
                        HeadersVisibility="Column"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        MaxHeight="320">


                        <!-- ================================================= -->
                        <!-- DATA GRID STYLES -->
                        <!-- ================================================= -->

                        <DataGrid.Resources>

                            <!-- Header -->

                            <Style
                            TargetType="DataGridColumnHeader">

                                <Setter
                                Property="Foreground"
                                Value="#AFAFAF"/>

                                <Setter
                                Property="Background"
                                Value="#292929"/>

                                <Setter
                                Property="BorderThickness"
                                Value="0"/>

                                <Setter
                                Property="Padding"
                                Value="8,6"/>

                                <Setter
                                Property="FontSize"
                                Value="10"/>

                                <Setter
                                Property="FontWeight"
                                Value="SemiBold"/>

                            </Style>


                            <!-- Cells -->

                            <Style
                            TargetType="DataGridCell">

                                <Setter
                                Property="Foreground"
                                Value="#E5E5E5"/>

                                <Setter
                                Property="Background"
                                Value="Transparent"/>

                                <Setter
                                Property="BorderThickness"
                                Value="0"/>

                                <Setter
                                Property="Padding"
                                Value="8,5"/>

                                <Style.Triggers>

                                    <Trigger
                                    Property="IsSelected"
                                    Value="True">

                                        <Setter
                                        Property="Background"
                                        Value="#343434"/>

                                        <Setter
                                        Property="Foreground"
                                        Value="White"/>

                                    </Trigger>

                                    <Trigger
                                    Property="IsMouseOver"
                                    Value="True">

                                        <Setter
                                        Property="Background"
                                        Value="#2C2C2C"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>


                            <!-- Editing -->

                            <Style
                            x:Key="EditingTextBoxStyle"
                            TargetType="TextBox">

                                <Setter
                                Property="Foreground"
                                Value="White"/>

                                <Setter
                                Property="Background"
                                Value="#343434"/>

                                <Setter
                                Property="BorderBrush"
                                Value="#505050"/>

                                <Setter
                                Property="BorderThickness"
                                Value="1"/>

                                <Setter
                                Property="CaretBrush"
                                Value="White"/>

                                <Setter
                                Property="Padding"
                                Value="5,2"/>

                            </Style>

                        </DataGrid.Resources>


                        <!-- ================================================= -->
                        <!-- COLUMNS -->
                        <!-- ================================================= -->

                        <DataGrid.Columns>

                            <DataGridTextColumn
                            Header="Account"
                            Binding="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="1.2*"
                            MinWidth="110"
                            EditingElementStyle="{StaticResource EditingTextBoxStyle}"/>


                            <DataGridTextColumn
                            Header="Username"
                            Binding="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="1.2*"
                            MinWidth="110"
                            EditingElementStyle="{StaticResource EditingTextBoxStyle}"/>


                            <DataGridTextColumn
                            Header="Email"
                            Binding="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="1.4*"
                            MinWidth="130"
                            EditingElementStyle="{StaticResource EditingTextBoxStyle}"/>


                            <DataGridTextColumn
                            Header="Password"
                            Binding="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="1.1*"
                            MinWidth="100"
                            EditingElementStyle="{StaticResource EditingTextBoxStyle}"/>


                            <DataGridTextColumn
                            Header="Notes"
                            Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="1.6*"
                            MinWidth="130"
                            EditingElementStyle="{StaticResource EditingTextBoxStyle}"/>


                            <!-- Delete -->

                            <DataGridTemplateColumn
                            Header=""
                            Width="38"
                            MinWidth="38"
                            MaxWidth="38">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                        Width="24"
                                        Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="Delete Entry"
                                        Click="DeleteEntry_Click">

                                            <TextBlock
                                            Text="🗑"
                                            FontSize="13"
                                            Foreground="#C8C8C8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        </Button>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>


























