<Window x:Class="Aegis.App.Verification.TotpRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticator Verification"
        Height="500" Width="625"
        Background="{StaticResource ContentBackground}"
        WindowStartupLocation="CenterScreen">


    <Grid Background="#111318">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
         HEADER
         ========================================================= -->

        <Border Grid.Row="0"
            Padding="34,28,34,24"
            BorderBrush="#252932"
            BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock Text="Two-Factor Authentication"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="Secure your Aegis account with an authenticator app."
                       Foreground="#9DA3AE"
                       FontSize="13"
                       TextAlignment="Center"
                       Margin="0,7,0,0"/>

            </StackPanel>

        </Border>


        <!-- =========================================================
         CONTENT
         ========================================================= -->

        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

            <StackPanel Width="520"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    Margin="40,32,40,36">


                <!-- =================================================
                 QR CARD
                 ================================================= -->

                <Border Background="#171A20"
                    BorderBrush="#292D35"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28">

                    <StackPanel>

                        <TextBlock Text="1  •  Scan the QR code"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Open your authenticator app and scan the QR code below."
                               Foreground="#9DA3AE"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,7,0,22"/>

                        <Border Width="240"
                            Height="240"
                            Padding="14"
                            Background="White"
                            CornerRadius="10"
                            HorizontalAlignment="Center">

                            <Image x:Name="QRCodeImage"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"/>

                        </Border>

                        <TextBlock Text="Use Google Authenticator, Microsoft Authenticator, Authy, or another compatible TOTP app."
                               Foreground="#737A86"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="28,18,28,0"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                 DIVIDER
                 ================================================= -->

                <Grid Margin="0,28,0,28">

                    <Rectangle Height="1"
                           Fill="#292D35"
                           VerticalAlignment="Center"/>

                    <Border Background="#111318"
                        Padding="16,0"
                        HorizontalAlignment="Center">

                        <TextBlock Text="VERIFY YOUR AUTHENTICATOR"
                               Foreground="#737A86"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    </Border>

                </Grid>


                <!-- =================================================
                 CODE CARD
                 ================================================= -->

                <Border Background="#171A20"
                    BorderBrush="#292D35"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28">

                    <StackPanel>

                        <TextBlock Text="2  •  Enter the verification code"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="Enter the current 6-digit code displayed by your authenticator."
                               Foreground="#9DA3AE"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,7,0,18"/>


                        <!-- CODE INPUT -->

                        <TextBox x:Name="CodeTextBox"
                             Style="{StaticResource AegisTextBox}"
                             Width="210"
                             Height="50"
                             MaxLength="6"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="22"
                             FontWeight="SemiBold"
                             InputScope="Number"/>


                        <!-- STATUS -->

                        <Border x:Name="StatusBorder"
                            Background="#1B1E25"
                            BorderBrush="#30343D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,10"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">

                            <TextBlock x:Name="StatusText"
                                   Foreground="#CCCCCC"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        </Border>


                        <!-- CONFIRM -->

                        <Button x:Name="ConfirmButton"
                            Content="Verify Code"
                            Style="{StaticResource AegisButton}"
                            Click="ConfirmButton_Click"
                            Width="210"
                            Height="44"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"/>


                        <TextBlock Text="Your verification code changes every 30 seconds."
                               Foreground="#666D78"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                 SECURITY NOTE
                 ================================================= -->

                <Border Background="#14171C"
                    BorderBrush="#242831"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,20,0,0">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="ⓘ"
                               Foreground="#8C94A1"
                               FontSize="15"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>

                        <TextBlock Text="Keep your authenticator app secure. Never share your verification code with anyone."
                               Foreground="#808793"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- =========================================================
         FOOTER
         ========================================================= -->

        <Border Grid.Row="2"
            Padding="24,15"
            BorderBrush="#252932"
            BorderThickness="0,1,0,0">

            <TextBlock Text="Aegis Security"
                   Foreground="#666D78"
                   FontSize="11"
                   HorizontalAlignment="Center"/>

        </Border>

    </Grid>

</Window>





