<Window x:Class="Aegis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        Background="#1E1E1E">


    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="WindowBackground"
                     Color="#1E1E1E"/>

        <SolidColorBrush x:Key="TitleBarBackground"
                     Color="#111111"/>

        <SolidColorBrush x:Key="MenuBackground"
                     Color="#252526"/>

        <SolidColorBrush x:Key="MenuHoverBackground"
                     Color="#333337"/>

        <SolidColorBrush x:Key="MenuSelectedBackground"
                     Color="#414144"/>

        <SolidColorBrush x:Key="MenuForeground"
                     Color="#F2F2F2"/>

        <SolidColorBrush x:Key="MenuSecondaryForeground"
                     Color="#A0A0A0"/>

        <SolidColorBrush x:Key="ContentBackground"
                     Color="#1E1E1E"/>

        <!-- ========================================================= -->
        <!-- HAMBURGER BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="HamburgerToggleStyle"
           TargetType="{x:Type ToggleButton}">

            <Setter Property="Width"
                Value="60"/>

            <Setter Property="Height"
                Value="46"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Padding"
                Value="0"/>

            <Setter Property="FontSize"
                Value="25"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                        <Border x:Name="HamburgerBorder"
                            Background="{TemplateBinding Background}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="HamburgerBorder"
                                    Property="Background"
                                    Value="{StaticResource MenuHoverBackground}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="HamburgerBorder"
                                    Property="Background"
                                    Value="{StaticResource MenuSelectedBackground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- WINDOW CONTROL BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="WindowButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Width"
                Value="44"/>

            <Setter Property="Height"
                Value="40"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Padding"
                Value="10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="WindowButtonBorder"
                            Background="{TemplateBinding Background}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="WindowButtonBorder"
                                    Property="Background"
                                    Value="#333333"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="WindowButtonBorder"
                                    Property="Background"
                                    Value="#444444"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- CLOSE BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="CloseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource WindowButtonStyle}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CloseBorder"
                            Background="Transparent">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#C42B1C"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#A82015"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- MENU ITEMS -->
        <!-- ========================================================= -->

        <Style x:Key="MenuItemStyle"
           TargetType="{x:Type ListBoxItem}">

            <Setter Property="Foreground"
                Value="{StaticResource MenuForeground}"/>

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Padding"
                Value="0"/>

            <Setter Property="Margin"
                Value="6,2"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ListBoxItem}">

                        <Border x:Name="MenuItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="0">

                            <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="MenuItemBorder"
                                    Property="Background"
                                    Value="{StaticResource MenuHoverBackground}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                 Value="True">

                                <Setter TargetName="MenuItemBorder"
                                    Property="Background"
                                    Value="{StaticResource MenuSelectedBackground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- ROOT -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource WindowBackground}">

        <Grid.RowDefinitions>

            <!-- Custom title bar -->
            <RowDefinition Height="40"/>

            <!-- Main application -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- CUSTOM TITLE BAR -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
            Background="{StaticResource TitleBarBackground}"
            MouseDown="TopBar_MouseDown">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Application title -->

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">

                    <TextBlock Text="Aegis"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                    <TextBlock Text="  •  Secure Encryption Suite"
                           Foreground="#777777"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="4,1,0,0"/>

                </StackPanel>


                <!-- Window controls -->

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">

                    <!-- Minimize -->

                    <Button Style="{StaticResource WindowButtonStyle}"
                        Click="Minimize_Click"
                        ToolTip="Minimize">

                        <TextBlock Text="—"
                               FontSize="16"
                               Foreground="#D0D0D0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                    <!-- Close -->

                    <Button Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click"
                        ToolTip="Close">

                        <TextBlock Text="×"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN APPLICATION AREA -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Navigation -->
                <ColumnDefinition x:Name="MenuColumn"
                              Width="60"/>

                <!-- Content -->
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- NAVIGATION MENU -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                Background="{StaticResource MenuBackground}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="46"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- Hamburger -->

                    <ToggleButton x:Name="MenuToggle"
                              Grid.Row="0"
                              Content="☰"
                              Style="{StaticResource HamburgerToggleStyle}"
                              Checked="MenuToggle_Checked"
                              Unchecked="MenuToggle_Unchecked"
                              ToolTip="Expand Menu"
                              IsChecked="False"/>


                    <!-- Navigation -->

                    <ListBox x:Name="MenuList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="MenuList_SelectionChanged"
                         ItemContainerStyle="{StaticResource MenuItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">


                        <!-- LOGIN -->

                        <ListBoxItem Tag="Login"
                                 ToolTip="Login">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/login.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="Login"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>


                        <!-- REGISTER -->

                        <ListBoxItem Tag="Register"
                                 ToolTip="Register">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/add-user.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="Register"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>


                        <!-- VAULT -->

                        <ListBoxItem Tag="Vault"
                                 ToolTip="Vault">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/vault.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="Vault"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>


                        <!-- FILE ENCRYPTION -->

                        <ListBoxItem Tag="FileEncryption"
                                 ToolTip="File Encryption">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/data-encryption.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="File Encryption"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>


                        <!-- HASH -->

                        <ListBoxItem Tag="Hash"
                                 ToolTip="Hash">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/cryptography.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="Hash"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>


                        <!-- SETTINGS -->

                        <ListBoxItem Tag="Settings"
                                 ToolTip="Settings">

                            <StackPanel Orientation="Horizontal"
                                    Height="52"
                                    VerticalAlignment="Center">

                                <Image Source="/Images/cogwheel.png"
                                   Width="28"
                                   Height="28"
                                   Margin="10,0"/>

                                <TextBlock Text="Settings"
                                       Foreground="{StaticResource MenuForeground}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       Margin="8,0"/>

                            </StackPanel>

                        </ListBoxItem>

                    </ListBox>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- PAGE CONTENT -->
            <!-- ===================================================== -->

            <Border Grid.Column="1"
                Background="{StaticResource ContentBackground}">

                <Frame x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   VerticalContentAlignment="Stretch"
                   Background="{StaticResource ContentBackground}"/>

            </Border>

        </Grid>

    </Grid>

</Window>




